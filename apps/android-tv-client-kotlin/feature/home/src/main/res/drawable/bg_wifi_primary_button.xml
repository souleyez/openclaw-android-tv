<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#74C8FF"
                android:startColor="#4E89FF" />
            <corners android:radius="20dp" />
            <stroke
                android:width="2dp"
                android:color="#D3F1FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#3E6690"
                android:startColor="#315A84" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="#7EA8D1" />
        </shape>
    </item>
</selector>
