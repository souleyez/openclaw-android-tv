<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_surface"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101419"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingTop="28dp"
    android:paddingEnd="32dp"
    android:paddingBottom="28dp">

    <LinearLayout
        android:id="@+id/assistant_hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#17202A"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/capability_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#254B7A"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/feature_home_capability_label"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hero_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/feature_home_title"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/assistant_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/feature_home_subtitle"
            android:textColor="#C1CBD7"
            android:textSize="16sp" />

        <Button
            android:id="@+id/primary_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:minWidth="180dp"
            android:text="@string/feature_home_primary_action" />
    </LinearLayout>

    <TextView
        android:id="@+id/app_rail_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/feature_home_app_rail_title"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/app_rail"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:focusable="false"
        android:overScrollMode="never"
        android:paddingEnd="12dp" />

</LinearLayout>
