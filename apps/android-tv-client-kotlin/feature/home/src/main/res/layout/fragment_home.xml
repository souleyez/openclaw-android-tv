<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_surface"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#091019">

    <ImageView
        android:id="@+id/background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.32"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9091019" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingTop="16dp"
        android:paddingEnd="30dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/brand_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="RS AITV"
                android:textColor="#F7FBFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#1F2731"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="12dp"
                android:paddingBottom="7dp">

                <ImageView
                    android:id="@+id/wifi_status_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_home_wifi" />

                <TextView
                    android:id="@+id/wifi_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="未联网"
                    android:textColor="#F7FBFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hero_card"
            android:layout_width="match_parent"
            android:layout_height="248dp"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:background="@drawable/bg_home_hero_card"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/mode_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#29486B"
                    android:paddingStart="11dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="5dp"
                    android:text="在线待命"
                    android:textColor="#F7FBFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hero_dialogue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="3"
                    android:textColor="#FFF7EF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hero_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="2"
                    android:textColor="#F3E1CD"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/token_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_token_button"
                    android:backgroundTint="@null"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    android:text="服务中心"
                    android:textAllCaps="false"
                    android:textColor="#FDF7EF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/model_renewal_payment_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#EAF7FBFF"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/model_renewal_qr_image"
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:background="#FFFFFFFF"
                        android:contentDescription="微信支付二维码"
                        android:padding="4dp"
                        android:scaleType="fitCenter" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/model_renewal_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#152331"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/model_renewal_amount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#086E4C"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/model_renewal_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="1dp"
                            android:maxLines="2"
                            android:textColor="#3A4D5E"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/notice_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="#66202A35"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/notice_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/notice_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                    android:textColor="#D2DBE5"
                    android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/hero_ad_card"
                android:layout_width="408dp"
                android:layout_height="180dp"
                android:layout_marginStart="10dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_home_hero_ad_card"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:padding="6dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#33251D">

                    <ImageView
                        android:id="@+id/hero_ad_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:adjustViewBounds="true"
                        android:background="#33251D"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#00000000" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:id="@+id/hero_ad_caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#FFF7EF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/hero_ad_index"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="#FFF0DE"
                            android:textSize="10sp" />
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/assistant_art_frame"
                android:layout_width="230dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_gravity="center_vertical">

                <View
                    android:id="@+id/assistant_shadow"
                    android:layout_width="114dp"
                    android:layout_height="18dp"
                    android:layout_gravity="end|bottom"
                    android:layout_marginEnd="18dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_assistant_shadow" />

                <View
                    android:id="@+id/assistant_glow"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="end|top"
                    android:layout_marginTop="18dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/bg_assistant_glow" />

                <com.openclaw.tv.feature.home.AssistantSpriteView
                    android:id="@+id/assistant_character"
                    android:layout_width="210dp"
                    android:layout_height="224dp"
                    android:layout_gravity="end|bottom"
                    android:layout_marginEnd="2dp"
                    android:layout_marginBottom="2dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/assistant_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginBottom="18dp"
                    android:background="@drawable/bg_assistant_chip"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="语音伙伴"
                    android:textColor="#F7FBFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/main_content_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/featured_section_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="内容入口"
                    android:textColor="#F7FBFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/featured_rail"
                    android:layout_width="match_parent"
                    android:layout_height="124dp"
                    android:layout_marginTop="0dp"
                    android:clipToPadding="false"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:paddingEnd="10dp" />

                <LinearLayout
                    android:id="@+id/cast_standby_card"
                    android:layout_width="match_parent"
                    android:layout_height="92dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_cast_standby_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/cast_standby_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="投屏待机"
                                android:textColor="#F7FBFF"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/cast_device_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:background="@drawable/bg_cast_protocol_chip"
                                android:paddingStart="9dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="9dp"
                                android:paddingBottom="4dp"
                                android:text="RS AITV"
                                android:textColor="#D9F1FF"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/cast_network_hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#E1EBF6"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/cast_protocol_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#AFC0D3"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/cast_standby_button"
                        android:layout_width="142dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:background="@drawable/bg_wifi_primary_button"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="12dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp"
                        android:text="打开投屏设置"
                        android:textAllCaps="false"
                        android:textColor="#F7FBFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/wifi_section"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/wifi_section_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="选择 Wi-Fi 网络"
                        android:textColor="#F7FBFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/wifi_guide_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="#C8D3DF"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:id="@+id/wifi_content_row"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/wifi_list_panel"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_wifi_action_card"
                            android:orientation="vertical"
                            android:paddingStart="9dp"
                            android:paddingTop="9dp"
                            android:paddingEnd="9dp"
                            android:paddingBottom="9dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="候选网络"
                                android:textColor="#E4EDF7"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/wifi_empty_state"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:padding="2dp"
                                android:textColor="#D2DBE5"
                                android:textSize="13sp"
                                android:visibility="gone" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/wifi_list"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_marginTop="6dp"
                                android:layout_weight="1"
                                android:clipToPadding="false"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:nestedScrollingEnabled="false"
                                android:overScrollMode="never"
                                android:paddingEnd="2dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/wifi_action_card"
                            android:layout_width="304dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="14dp"
                            android:background="@drawable/bg_wifi_action_card"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingTop="14dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="14dp"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="网络操作"
                                android:textColor="#E4EDF7"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/wifi_selected_name"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:textColor="#FFFFFF"
                                android:textSize="19sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/wifi_selected_summary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:lineSpacingExtra="1dp"
                                android:maxLines="3"
                                android:textColor="#D2DBE5"
                                android:textSize="12sp" />

                            <Space
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <Button
                                android:id="@+id/wifi_connect_button"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_wifi_primary_button"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:paddingStart="18dp"
                                android:paddingTop="8dp"
                                android:paddingEnd="18dp"
                                android:paddingBottom="8dp"
                                android:text="连接这个网络"
                                android:textAllCaps="false"
                                android:textColor="#F7FBFF"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/wifi_system_settings_button"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_wifi_secondary_button"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:paddingStart="18dp"
                                android:paddingTop="8dp"
                                android:paddingEnd="18dp"
                                android:paddingBottom="8dp"
                                android:text="系统网络设置"
                                android:textAllCaps="false"
                                android:textColor="#F7FBFF"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/wifi_refresh_button"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_wifi_secondary_button"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:paddingStart="18dp"
                                android:paddingTop="8dp"
                                android:paddingEnd="18dp"
                                android:paddingBottom="8dp"
                                android:text="刷新列表"
                                android:textAllCaps="false"
                                android:textColor="#F7FBFF"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/quick_action_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/quick_action_section_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="快捷入口"
                    android:textColor="#F7FBFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/quick_action_rail"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:layout_marginTop="0dp"
                    android:clipToPadding="false"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:paddingEnd="10dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/local_apps_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#ED0C1218"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="52dp"
            android:paddingTop="24dp"
            android:paddingEnd="52dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_section_chip"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="应用总览"
                android:textColor="#DCE8F5"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/local_apps_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="应用管理"
                    android:textColor="#F7FBFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/local_apps_close_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_wifi_secondary_button"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="18dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="10dp"
                    android:text="返回首页"
                    android:textAllCaps="false"
                    android:textColor="#F7FBFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/local_apps_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="打开、卸载本机应用；U 盘或本机目录里的 APK 会自动出现在列表中，可直接安装或升级。"
                android:textColor="#C8D3DF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/local_apps_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_wifi_action_card"
                android:padding="18dp"
                android:text="正在扫描本机应用和 USB APK..."
                android:textColor="#D2DBE5"
                android:textSize="14sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/local_apps_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingBottom="8dp" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/service_center_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#ED0C1218"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="52dp"
            android:paddingTop="24dp"
            android:paddingEnd="52dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_section_chip"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="服务中心"
                android:textColor="#DCE8F5"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="套餐与续费"
                    android:textColor="#F7FBFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/service_center_close_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_wifi_secondary_button"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="18dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="10dp"
                    android:text="返回首页"
                    android:textAllCaps="false"
                    android:textColor="#F7FBFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="18dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/service_package_vip_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_wifi_action_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/service_package_vip_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="大会员套餐"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/service_package_vip_duration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="30天"
                        android:textColor="#C8D3DF"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/service_package_vip_amount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="CNY 0.01"
                        android:textColor="#79F2B0"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/service_package_vip_qr"
                        android:layout_width="168dp"
                        android:layout_height="168dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="18dp"
                        android:background="#FFFFFFFF"
                        android:contentDescription="大会员套餐微信支付二维码"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/service_package_vip_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_horizontal"
                        android:text="正在生成微信支付二维码..."
                        android:textColor="#D2DBE5"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/service_package_ai_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_wifi_action_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/service_package_ai_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="AI服务套餐"
                        android:textColor="#FFFFFF"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/service_package_ai_duration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="30天"
                        android:textColor="#C8D3DF"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/service_package_ai_amount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="CNY 0.01"
                        android:textColor="#79F2B0"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/service_package_ai_qr"
                        android:layout_width="168dp"
                        android:layout_height="168dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="18dp"
                        android:background="#FFFFFFFF"
                        android:contentDescription="AI服务套餐微信支付二维码"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/service_package_ai_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_horizontal"
                        android:text="正在生成微信支付二维码..."
                        android:textColor="#D2DBE5"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
