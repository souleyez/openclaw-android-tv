<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_surface"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E141B">

    <ImageView
        android:id="@+id/background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.32"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D20E141B" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="28dp"
        android:paddingEnd="40dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/brand_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="RS AITV"
                android:textColor="#F7FBFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#1F2731"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="9dp"
                android:paddingEnd="14dp"
                android:paddingBottom="9dp">

                <ImageView
                    android:id="@+id/wifi_status_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_home_wifi" />

                <TextView
                    android:id="@+id/wifi_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="未联网"
                    android:textColor="#F7FBFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hero_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_home_hero_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="24dp">

            <FrameLayout
                android:layout_width="312dp"
                android:layout_height="360dp">

                    <View
                        android:id="@+id/assistant_shadow"
                        android:layout_width="188dp"
                        android:layout_height="34dp"
                        android:layout_gravity="center_horizontal|bottom"
                        android:layout_marginBottom="22dp"
                        android:background="@drawable/bg_assistant_shadow" />

                    <View
                        android:id="@+id/assistant_glow"
                        android:layout_width="272dp"
                        android:layout_height="272dp"
                        android:layout_gravity="center_horizontal|top"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_assistant_glow" />

                    <View
                        android:id="@+id/assistant_hair"
                        android:layout_width="156dp"
                        android:layout_height="176dp"
                        android:layout_gravity="center_horizontal|top"
                        android:layout_marginTop="46dp"
                        android:background="@drawable/bg_assistant_hair" />

                    <View
                        android:id="@+id/assistant_ribbon_left"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center_horizontal|top"
                        android:layout_marginTop="84dp"
                        android:background="@drawable/bg_assistant_ribbon"
                        android:translationX="-66dp" />

                    <View
                        android:id="@+id/assistant_ribbon_right"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center_horizontal|top"
                        android:layout_marginTop="84dp"
                        android:background="@drawable/bg_assistant_ribbon"
                        android:scaleX="-1"
                        android:translationX="66dp" />

                    <View
                        android:id="@+id/assistant_side_lock_left"
                        android:layout_width="36dp"
                        android:layout_height="108dp"
                        android:layout_gravity="center_horizontal|top"
                        android:layout_marginTop="98dp"
                        android:background="@drawable/bg_assistant_side_lock"
                        android:translationX="-70dp" />

                    <View
                        android:id="@+id/assistant_side_lock_right"
                        android:layout_width="36dp"
                        android:layout_height="108dp"
                        android:layout_gravity="center_horizontal|top"
                        android:layout_marginTop="98dp"
                        android:background="@drawable/bg_assistant_side_lock"
                        android:scaleX="-1"
                        android:translationX="70dp" />

                    <View
                        android:layout_width="114dp"
                        android:layout_height="128dp"
                        android:layout_gravity="center_horizontal|top"
                        android:layout_marginTop="74dp"
                        android:background="@drawable/bg_assistant_face" />

                    <View
                        android:id="@+id/assistant_hair_bang"
                        android:layout_width="118dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center_horizontal|top"
                        android:layout_marginTop="68dp"
                        android:background="@drawable/bg_assistant_hair_bang" />

                    <View
                        android:layout_width="12dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center_horizontal|top"
                        android:layout_marginTop="124dp"
                        android:background="@drawable/bg_assistant_eye"
                        android:translationX="-22dp" />

                    <View
                        android:layout_width="12dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center_horizontal|top"
                        android:layout_marginTop="124dp"
                        android:background="@drawable/bg_assistant_eye"
                        android:translationX="22dp" />

                    <View
                        android:layout_width="18dp"
                        android:layout_height="10dp"
                        android:layout_gravity="center_horizontal|top"
                        android:layout_marginTop="150dp"
                        android:background="@drawable/bg_assistant_eye" />

                    <View
                        android:layout_width="24dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center_horizontal|top"
                        android:layout_marginTop="142dp"
                        android:background="@drawable/bg_assistant_blush"
                        android:translationX="-34dp" />

                    <View
                        android:layout_width="24dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center_horizontal|top"
                        android:layout_marginTop="142dp"
                        android:background="@drawable/bg_assistant_blush"
                        android:translationX="34dp" />

                    <View
                        android:layout_width="36dp"
                        android:layout_height="94dp"
                        android:layout_gravity="center_horizontal|top"
                        android:layout_marginTop="176dp"
                        android:background="@drawable/bg_assistant_arm"
                        android:translationX="-78dp" />

                    <View
                        android:layout_width="36dp"
                        android:layout_height="94dp"
                        android:layout_gravity="center_horizontal|top"
                        android:layout_marginTop="176dp"
                        android:background="@drawable/bg_assistant_arm"
                        android:translationX="78dp" />

                    <View
                        android:id="@+id/assistant_dress"
                        android:layout_width="118dp"
                        android:layout_height="112dp"
                        android:layout_gravity="center_horizontal|top"
                        android:layout_marginTop="164dp"
                        android:background="@drawable/bg_assistant_dress" />

                    <TextView
                        android:id="@+id/assistant_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal|top"
                        android:layout_marginTop="220dp"
                        android:background="@drawable/bg_assistant_chip"
                        android:paddingStart="14dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="7dp"
                        android:text="语音伙伴"
                        android:textColor="#F7FBFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <View
                        android:id="@+id/assistant_skirt"
                        android:layout_width="162dp"
                        android:layout_height="94dp"
                        android:layout_gravity="center_horizontal|top"
                        android:layout_marginTop="228dp"
                        android:background="@drawable/bg_assistant_skirt" />

                    <View
                        android:layout_width="22dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center_horizontal|top"
                        android:layout_marginTop="286dp"
                        android:background="@drawable/bg_assistant_leg"
                        android:translationX="-24dp" />

                    <View
                        android:layout_width="22dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center_horizontal|top"
                        android:layout_marginTop="286dp"
                        android:background="@drawable/bg_assistant_leg"
                        android:translationX="24dp" />

                    <View
                        android:layout_width="44dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center_horizontal|bottom"
                        android:layout_marginBottom="30dp"
                        android:background="@drawable/bg_assistant_shoe"
                        android:translationX="-20dp" />

                    <View
                        android:layout_width="44dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center_horizontal|bottom"
                        android:layout_marginBottom="30dp"
                        android:background="@drawable/bg_assistant_shoe"
                        android:translationX="20dp" />

                <Button
                    android:id="@+id/token_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|bottom"
                    android:background="@drawable/bg_token_button"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="18dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="10dp"
                    android:text="服务中心"
                    android:textAllCaps="false"
                    android:textColor="#1B2029"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/mode_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#29486B"
                    android:paddingStart="14dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="7dp"
                    android:text="在线待命"
                    android:textColor="#F7FBFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hero_dialogue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hero_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="#C8D3DF"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/hero_ad_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_home_hero_ad_card"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/hero_ad_image"
                        android:layout_width="match_parent"
                        android:layout_height="148dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/hero_ad_caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#F7FBFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/hero_ad_index"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:textColor="#C8D3DF"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/notice_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="#66202A35"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/notice_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/notice_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="#D2DBE5"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="18dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.46"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/featured_section_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="内容入口"
                    android:textColor="#F7FBFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/featured_rail"
                    android:layout_width="match_parent"
                    android:layout_height="214dp"
                    android:layout_marginTop="12dp"
                    android:clipToPadding="false"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:paddingEnd="10dp" />

                <LinearLayout
                    android:id="@+id/wifi_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/wifi_section_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Wi-Fi 连接"
                        android:textColor="#F7FBFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/wifi_guide_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="#C8D3DF"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:id="@+id/wifi_action_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_wifi_action_card"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/wifi_selected_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/wifi_selected_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="2dp"
                            android:textColor="#D2DBE5"
                            android:textSize="14sp" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:fadeScrollbars="false"
                            android:overScrollMode="never"
                            android:scrollbars="none">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <Button
                                    android:id="@+id/wifi_connect_button"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_wifi_primary_button"
                                    android:focusable="true"
                                    android:focusableInTouchMode="true"
                                    android:minWidth="0dp"
                                    android:minHeight="0dp"
                                    android:paddingStart="18dp"
                                    android:paddingTop="10dp"
                                    android:paddingEnd="18dp"
                                    android:paddingBottom="10dp"
                                    android:text="连接这个网络"
                                    android:textAllCaps="false"
                                    android:textColor="#F7FBFF"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <Button
                                    android:id="@+id/wifi_system_settings_button"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:background="@drawable/bg_wifi_secondary_button"
                                    android:focusable="true"
                                    android:focusableInTouchMode="true"
                                    android:minWidth="0dp"
                                    android:minHeight="0dp"
                                    android:paddingStart="18dp"
                                    android:paddingTop="10dp"
                                    android:paddingEnd="18dp"
                                    android:paddingBottom="10dp"
                                    android:text="系统网络设置"
                                    android:textAllCaps="false"
                                    android:textColor="#F7FBFF"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <Button
                                    android:id="@+id/wifi_refresh_button"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:background="@drawable/bg_wifi_secondary_button"
                                    android:focusable="true"
                                    android:focusableInTouchMode="true"
                                    android:minWidth="0dp"
                                    android:minHeight="0dp"
                                    android:paddingStart="18dp"
                                    android:paddingTop="10dp"
                                    android:paddingEnd="18dp"
                                    android:paddingBottom="10dp"
                                    android:text="刷新列表"
                                    android:textAllCaps="false"
                                    android:textColor="#F7FBFF"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </HorizontalScrollView>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/wifi_empty_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="#66202A35"
                        android:padding="16dp"
                        android:textColor="#D2DBE5"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/wifi_list"
                        android:layout_width="match_parent"
                        android:layout_height="196dp"
                        android:layout_marginTop="12dp"
                        android:clipToPadding="false"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="20dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.94"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/quick_action_section_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="快捷入口"
                    android:textColor="#F7FBFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/quick_action_rail"
                    android:layout_width="match_parent"
                    android:layout_height="214dp"
                    android:layout_marginTop="12dp"
                    android:clipToPadding="false"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:paddingEnd="10dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/local_apps_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#ED0C1218"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="52dp"
            android:paddingTop="34dp"
            android:paddingEnd="52dp"
            android:paddingBottom="34dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_home_section_chip"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="应用总览"
                android:textColor="#DCE8F5"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/local_apps_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="本机应用"
                    android:textColor="#F7FBFF"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/local_apps_close_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_wifi_secondary_button"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="18dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="10dp"
                    android:text="返回首页"
                    android:textAllCaps="false"
                    android:textColor="#F7FBFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/local_apps_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="显示这台 TV 当前可直接启动的应用，按返回键或右上角按钮可关闭。"
                android:textColor="#C8D3DF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/local_apps_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_wifi_action_card"
                android:padding="18dp"
                android:text="当前没有扫描到可直接启动的本机应用。"
                android:textColor="#D2DBE5"
                android:textSize="14sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/local_apps_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="18dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingBottom="12dp" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
